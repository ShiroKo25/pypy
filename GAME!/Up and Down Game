import random
import tkinter as tk

num = random.choice(range(1, 101))

cnt = 0
a = 'Try count: '

def dispLabel():
    global cnt
    cnt += 1
    cnt_lbl.configure(text = a + str(cnt))
    input_num = int(tk.Entry.get(edt))
    if num == input_num:
        lbl.configure(text = "Congratulation You Win.")
    elif num > input_num:
        lbl.configure(text = ("UP"))
    elif num < input_num:
        lbl.configure(text = ("DOWN"))

root = tk.Tk()
root.geometry("200x100")

lbl = tk.Label(text = "Made by _xjb")
edt = tk.Entry(width=12)
btn = tk.Button(text = "Push", command = dispLabel)

cnt_lbl = tk.Label(text = "Try count:  ")

lbl.pack()
edt.pack()
btn.pack()
cnt_lbl.pack()
tk.mainloop()

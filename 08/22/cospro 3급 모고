문제 1번:
a = list(map(str, input().split()))
b = []

for i in range(len(a)):
    if i % 2 == 1:
        b.append(a[i].upper())
    elif i % 2 == 0:
        b.append(a[i].lower())
print(*b)
문제 2번:
a = list(map(str, input().split()))
max_num = a[0]
min_num = a[0]

for i in range(1, len(a)):
    if int(a[i]) > int(max_num):
        max_num = a[i]
    elif int(a[i]) < int(min_num):
        min_num = a[i]
print(max_num, min_num)

